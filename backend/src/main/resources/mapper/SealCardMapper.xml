        <result column="row_version" property="rowVersion" />
        <result column="created_by" property="createdBy" />
        <result column="disabled_by" property="disabledBy" />
        <result column="disabled_at" property="disabledAt" />
        <result column="disable_reason" property="disableReason" />
        <result column="remark" property="remark" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, card_no, customer_no, branch_no, current_version_id, status, row_version, created_by, disabled_by, disabled_at, disable_reason, remark, created_at, updated_at
    </sql>

</mapper>
